rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Backup pessoal isolado de cada usuário (apenas o próprio usuário autenticado pode ler e gravar)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. Metadados dos Projetos Compartilhados da Equipe
    match /projects/{projectId} {
      // Usuários autenticados podem consultar os metadados dos projetos
      allow read: if request.auth != null;
      // Qualquer usuário autenticado pode criar um novo projeto
      allow create: if request.auth != null;
      // Apenas o criador ou membros listados podem atualizar metadados
      allow update: if request.auth != null && (
        resource.data.criadorUid == request.auth.uid ||
        resource.data.criadorEmail == request.auth.token.email ||
        (resource.data.membrosEmails is list && request.auth.token.email in resource.data.membrosEmails)
      );
      // Apenas o criador legítimo pode excluir o projeto
      allow delete: if request.auth != null && (
        resource.data.criadorUid == request.auth.uid ||
        resource.data.criadorEmail == request.auth.token.email
      );
    }
    
    // 3. Medições e Cubagens Compartilhadas do Projeto
    match /projects/{projectId}/{allSubcollections=**} {
      allow read, write: if request.auth != null;
    }
  }
}


