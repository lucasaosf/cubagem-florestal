rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Backup pessoal isolado de cada usuário
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // 2. Metadados dos Projetos Compartilhados da Equipe (Criador, Integrantes e Frente)
    match /projects/{projectId} {
      allow read, write: if request.auth != null;
    }
    
    // 3. Medições e Cubagens Compartilhadas de Cada Projeto da Equipe
    match /projects/{projectId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 4. Regra geral para usuários autenticados
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

